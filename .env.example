# MarketMind Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# --- Required ---
GROQ_API_KEY=your_groq_api_key_here
# Get free key at: https://console.groq.com
# Powers all LLM agent calls (Llama 3.3 70B)

NEWS_API_KEY=your_newsapi_key_here
# Get free key at: https://newsapi.org
# Powers the Sentiment Agent (100 req/day free tier)

FRED_API_KEY=your_fred_api_key_here
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Powers the Macro Agent (10-year treasury yield)

# --- Optional (Phase 2 — live paper trading) ---
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
# Get free paper trading keys at: https://alpaca.markets
